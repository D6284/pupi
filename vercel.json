{
    "version": 2,
    "builds": [
        {
            "src": "pups/server.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "pups/**/*"
                ],
                "excludeFiles": [
                    "pups/db.json",
                    "pups/db.backup.json",
                    "pups/.env"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "pups/server.js"
        }
    ]
}