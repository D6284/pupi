# Supabase PostgreSQL connection string. Use the Supavisor transaction/session pooler for serverless workloads.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
BUSINESS_ID=biz_001
PG_POOL_MAX=2

# Generate a unique, stable secret (at least 32 random bytes) and a bcrypt hash for the initial admin passcode.
JWT_SECRET=
ADMIN_PASSWORD_HASH=

# Optional AI provider key. Never put this in browser code or database JSON.
GEMINI_API_KEY=

# Comma-separated browser origins only when cross-origin access is intentionally required.
CORS_ORIGINS=
